# Godot 4 + .NET
.godot/
.import/
export.cfg
export_presets.cfg
*.translation
*.csproj.old

# .NET / C#
.mono/
data_*/
mono_crash.*
[Bb]in/
[Oo]bj/
*.user

# Godot-generated desktop binaries (exported build output at repo root)
/*.exe

# Audio: commit final .ogg/.wav; keep raw source projects and Godot import cache out
/assets/audio/Source/
/assets/audio/*.import

# Auto-generated version file (regenerated on every build from version.txt + git)
game/GameVersion.g.cs

# OS / editor
.DS_Store
Thumbs.db
.vs/
.idea/
.vscode/

# Art-pass review sheets (regenerate with python -m tools.artpass.contact_sheet)
art/review/

# Python bytecode from the art-pass tools
__pycache__/
*.pyc

# art/source is a conversion input, not a Godot asset dir - Godot still scans it
art/source/**/*.import
art/source/*.import
