{
  "_comment": "Authored art direction. Ramps run dark -> light and must be monotonic in luminance. Edges are absolute normalised-luminance thresholds; len(edges) == len(colors) - 1.",
  "families": {
    "rock":       { "colors": ["black", "brown", "orange", "grey"],                     "edges": [0.10, 0.30, 0.55] },
    "bedrock":    { "colors": ["black", "darkgrey", "grey", "lightgrey"],               "edges": [0.12, 0.38, 0.62] },
    "gold_ore":   { "colors": ["black", "brown", "orange", "yellow"],                   "edges": [0.10, 0.32, 0.62] },
    "gold":       { "colors": ["black", "brown", "orange", "yellow", "white"],          "edges": [0.08, 0.28, 0.55, 0.86] },
    "wood":       { "colors": ["black", "brown", "orange", "lightred"],                 "edges": [0.10, 0.30, 0.58] },
    "metal":      { "colors": ["black", "darkgrey", "grey", "lightgrey", "white"],      "edges": [0.08, 0.28, 0.50, 0.80] },
    "stone":      { "colors": ["black", "darkgrey", "grey", "lightgrey"],               "edges": [0.10, 0.34, 0.60] },
    "bone":       { "colors": ["black", "darkgrey", "lightgrey", "white"],              "edges": [0.12, 0.45, 0.88] },
    "flesh":      { "colors": ["black", "brown", "lightred", "yellow", "white"],        "edges": [0.10, 0.30, 0.55, 0.84],
                  "_hue_split": "Skin and the yellow hard hat overlap in luminance across the six miner variants (on veteran the hat is the darker of the two). Hue separates them cleanly: skins sit at 0.036-0.051, hats at 0.104-0.123.",
                  "hue_split": { "band": 3, "hue_below": 0.085, "color": "lightred" } },
    "slime":      { "colors": ["black", "green", "lightgreen", "white"],                "edges": [0.12, 0.50, 0.85] },
    "spectral":   { "colors": ["black", "blue", "lightblue", "cyan", "white"],          "edges": [0.15, 0.45, 0.70, 0.92] },
    "crystal":    { "colors": ["black", "blue", "lightblue", "cyan", "white"],          "edges": [0.08, 0.26, 0.48, 0.80] },
    "water":      { "colors": ["black", "blue", "lightblue", "cyan"],                   "edges": [0.08, 0.30, 0.60] },
    "deepwater":  { "colors": ["black", "blue", "lightblue"],                           "edges": [0.20, 0.70] },
    "lava":       { "colors": ["black", "red", "orange", "yellow", "white"],            "edges": [0.08, 0.26, 0.50, 0.84] },
    "beast":      { "colors": ["black", "blue", "purple", "lightred", "cyan"],          "edges": [0.08, 0.26, 0.48, 0.74] },
    "foliage":    { "colors": ["black", "green", "lightgreen", "yellow"],               "edges": [0.10, 0.40, 0.76] }
  },
  "_teams_comment": "Three-step ramps: outline, team identity, highlight. The IDENTITY is the middle band, not the brightest: it paints the trousers and torso, about 48% of a miner's pixels, whereas the top band is a ~4% shirt highlight. An earlier version made the top band the identity and four teams read as grey. yellow and lightred are unavailable - reserved for the hard hat and skin (see tint_preserve).",
  "teams": [
    { "name": "Gold",   "colors": ["black", "orange", "white"],    "edges": [0.20, 0.80], "identity": 1 },
    { "name": "Blue",   "colors": ["black", "blue", "white"],      "edges": [0.20, 0.80], "identity": 1 },
    { "name": "Red",    "colors": ["black", "red", "white"],       "edges": [0.20, 0.80], "identity": 1 },
    { "name": "Green",  "colors": ["black", "green", "white"],     "edges": [0.20, 0.80], "identity": 1 },
    { "name": "Purple", "colors": ["black", "purple", "white"],    "edges": [0.20, 0.80], "identity": 1 },
    { "name": "Rust",   "colors": ["black", "brown", "white"],     "edges": [0.20, 0.80], "identity": 1 },
    { "name": "Cyan",   "colors": ["black", "cyan", "white"],      "edges": [0.20, 0.80], "identity": 1 },
    { "name": "Silver", "colors": ["black", "lightgrey", "white"], "edges": [0.20, 0.80], "identity": 1 }
  ],
  "_tint_preserve_comment": "Palette colours a miner sprite keeps instead of taking the team colour. The flesh ramp puts skin on lightred and the hard hat on yellow, so those two are the miner's identity and everything else (outline, trousers, shirt) carries the team. This replaced an HSV heuristic that was calibrated on the pre-conversion art: after conversion lightred's hue wraps to 0.99 and yellow sits at 0.172, so both fell outside a hue<0.14 test and the whole miner went team-coloured.",
  "tint_preserve": ["lightred", "yellow"],
  "_exclude_comment": "Marketing art, redrawn wholesale in M6. Excluded from BOTH conversion and verification - posterising a 1024px icon to four bands would look worse than leaving it alone until it is redrawn. M6 deletes these entries.",
  "exclude": [
    "Icon.png",
    "Icon_Old.png",
    "Splash.png"
  ],
  "_region_comment": "combined_terrain_atlas.png packs five terrains into one 160x640 sheet as 5 blocks of 4 tile-rows. One ramp for the whole sheet turned lethal deep water into ordinary brown rock, so it is converted in bands. Deep water deliberately uses a darker ramp than shallow water - the two must never look alike.",
  "region_overrides": {
    "tiles/combined_terrain_atlas.png": [
      { "y": [0, 128],   "ramp": "lava"      },
      { "y": [128, 256], "ramp": "rock"      },
      { "y": [256, 384], "ramp": "bedrock"   },
      { "y": [384, 512], "ramp": "water"     },
      { "y": [512, 640], "ramp": "deepwater" }
    ]
  },
  "assign": [
    { "glob": "miners/**",                 "ramp": "flesh" },
    { "glob": "monsters/skeleton_*",       "ramp": "bone" },
    { "glob": "monsters/ghost/**",         "ramp": "spectral" },
    { "glob": "monsters/slime/**",         "ramp": "slime" },
    { "glob": "monsters/octopus/**",       "ramp": "beast" },
    { "glob": "monsters/water_snake/**",   "ramp": "water" },
    { "glob": "monsters/goat/**",          "ramp": "stone" },
    { "glob": "tiles/**",                  "ramp": "rock" },
    { "glob": "portals/**",                "ramp": "metal" },
    { "glob": "objects/idol_*",            "ramp": "gold" },
    { "glob": "objects/prize_*",           "ramp": "gold" },
    { "glob": "objects/**",                "ramp": "metal" }
  ],
  "overrides": {
